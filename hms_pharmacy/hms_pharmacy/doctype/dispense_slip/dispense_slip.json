{
  "name": "Dispense Slip",
  "module": "HMS Pharmacy",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-DIS-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "patient_name", "fieldtype": "Data", "label": "Patient Name", "fetch_from": "patient.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "prescription", "fieldtype": "Link", "label": "Prescription", "options": "Prescription"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "dispensed_by", "fieldtype": "Link", "label": "Dispensed By", "options": "User", "default": "__user"},
    {"fieldname": "dispense_datetime", "fieldtype": "Datetime", "label": "Dispense Date/Time", "default": "Now", "in_list_view": 1},
    {"fieldname": "pharmacy_store", "fieldtype": "Link", "label": "Pharmacy Store", "options": "Pharmacy Store"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nDispensed\nPartially Dispensed\nReturned\nCancelled", "default": "Draft", "in_list_view": 1},
    {"fieldname": "section_items", "fieldtype": "Section Break", "label": "Items"},
    {"fieldname": "items", "fieldtype": "Table", "label": "Dispense Items", "options": "Dispense Item"},
    {"fieldname": "section_totals", "fieldtype": "Section Break", "label": "Totals"},
    {"fieldname": "total_amount", "fieldtype": "Currency", "label": "Total Amount", "read_only": 1, "in_list_view": 1},
    {"fieldname": "discount_amount", "fieldtype": "Currency", "label": "Discount"},
    {"fieldname": "net_amount", "fieldtype": "Currency", "label": "Net Amount", "read_only": 1},
    {"fieldname": "section_safety", "fieldtype": "Section Break", "label": "Safety Checks"},
    {"fieldname": "safety_checks_passed", "fieldtype": "Check", "label": "Safety Checks Passed", "read_only": 1},
    {"fieldname": "safety_warnings", "fieldtype": "Small Text", "label": "Safety Warnings", "read_only": 1},
    {"fieldname": "pharmacist_override", "fieldtype": "Check", "label": "Pharmacist Override"},
    {"fieldname": "override_reason", "fieldtype": "Small Text", "label": "Override Reason", "depends_on": "pharmacist_override"}
  ],
  "permissions": [
    {"role": "Pharmacist", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1}
  ],
  "sort_field": "dispense_datetime", "sort_order": "DESC", "title_field": "patient_name"
}
