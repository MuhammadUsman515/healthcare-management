{
  "name": "Sample Collection",
  "module": "HMS LIS",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-SMP-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient", "reqd": 1, "in_list_view": 1},
    {"fieldname": "patient_name", "fieldtype": "Data", "label": "Patient Name", "fetch_from": "patient.full_name", "read_only": 1},
    {"fieldname": "lab_order", "fieldtype": "Link", "label": "Lab Order", "options": "Lab Order", "in_standard_filter": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "sample_type", "fieldtype": "Select", "label": "Sample Type", "options": "Blood\nSerum\nPlasma\nUrine\nStool\nSputum\nCSF\nSwab\nTissue\nOther", "reqd": 1, "in_list_view": 1},
    {"fieldname": "container", "fieldtype": "Link", "label": "Container", "options": "Sample Container"},
    {"fieldname": "collection_datetime", "fieldtype": "Datetime", "label": "Collection DateTime", "reqd": 1, "default": "Now", "in_list_view": 1},
    {"fieldname": "collected_by", "fieldtype": "Link", "label": "Collected By", "options": "User"},
    {"fieldname": "section_barcode", "fieldtype": "Section Break", "label": "Identification"},
    {"fieldname": "barcode", "fieldtype": "Data", "label": "Barcode / Accession Number", "unique": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Collected\nAccepted\nRejected\nProcessing\nCompleted", "default": "Collected", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "column_break_barcode", "fieldtype": "Column Break"},
    {"fieldname": "rejection_reason", "fieldtype": "Select", "label": "Rejection Reason", "options": "\nHemolyzed\nClotted\nInsufficient Volume\nWrong Container\nImproper Labeling\nLeaking\nExpired\nOther", "depends_on": "eval:doc.status=='Rejected'"},
    {"fieldname": "rejection_notes", "fieldtype": "Small Text", "label": "Rejection Notes", "depends_on": "eval:doc.status=='Rejected'"},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "Lab Technician", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Lab Supervisor", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1}
  ],
  "sort_field": "collection_datetime", "sort_order": "DESC", "title_field": "patient_name"
}
