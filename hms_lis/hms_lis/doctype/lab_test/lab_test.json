{
  "name": "Lab Test",
  "module": "HMS LIS",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-LT-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "patient_name", "fieldtype": "Data", "label": "Patient Name", "fetch_from": "patient.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "lab_order", "fieldtype": "Link", "label": "Lab Order", "options": "Lab Order"},
    {"fieldname": "test_template", "fieldtype": "Link", "label": "Test Template", "options": "Lab Test Template"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "test_name", "fieldtype": "Data", "label": "Test Name", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "test_group", "fieldtype": "Select", "label": "Test Group", "options": "\nHematology\nBiochemistry\nMicrobiology\nPathology\nSerology\nHormones\nUrinalysis\nOther", "in_standard_filter": 1},
    {"fieldname": "ordering_practitioner", "fieldtype": "Link", "label": "Ordering Practitioner", "options": "Practitioner"},
    {"fieldname": "order_date", "fieldtype": "Datetime", "label": "Order Date"},
    {"fieldname": "priority", "fieldtype": "Select", "label": "Priority", "options": "Normal\nUrgent\nSTAT", "default": "Normal"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Ordered\nSample Collected\nIn Process\nResult Entered\nVerified\nAuthorized\nReleased\nCancelled\nOutsourced", "default": "Ordered", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "section_results", "fieldtype": "Section Break", "label": "Results"},
    {"fieldname": "result_value", "fieldtype": "Data", "label": "Result Value"},
    {"fieldname": "result_unit", "fieldtype": "Data", "label": "Unit"},
    {"fieldname": "normal_range", "fieldtype": "Data", "label": "Normal Range"},
    {"fieldname": "result_status", "fieldtype": "Select", "label": "Result Status", "options": "\nNormal\nAbnormal\nCritical", "in_list_view": 1},
    {"fieldname": "column_break_results", "fieldtype": "Column Break"},
    {"fieldname": "result_entered_by", "fieldtype": "Link", "label": "Entered By", "options": "User"},
    {"fieldname": "result_entered_datetime", "fieldtype": "Datetime", "label": "Entered At"},
    {"fieldname": "verified_by", "fieldtype": "Link", "label": "Verified By", "options": "User"},
    {"fieldname": "verified_datetime", "fieldtype": "Datetime", "label": "Verified At"},
    {"fieldname": "authorized_by", "fieldtype": "Link", "label": "Authorized By", "options": "User"},
    {"fieldname": "authorized_datetime", "fieldtype": "Datetime", "label": "Authorized At"},
    {"fieldname": "section_tat", "fieldtype": "Section Break", "label": "Turnaround"},
    {"fieldname": "tat_minutes", "fieldtype": "Int", "label": "TAT (minutes)", "read_only": 1},
    {"fieldname": "result_comment", "fieldtype": "Text", "label": "Comment"},
    {"fieldname": "section_outsource", "fieldtype": "Section Break", "label": "Outsource", "depends_on": "eval:doc.status=='Outsourced'"},
    {"fieldname": "outsourced_to", "fieldtype": "Data", "label": "Outsourced To"},
    {"fieldname": "outsource_date", "fieldtype": "Date", "label": "Outsource Date"}
  ],
  "permissions": [
    {"role": "Lab Technician", "read": 1, "write": 1, "create": 1},
    {"role": "Lab Supervisor", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "Physician", "read": 1},
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1}
  ],
  "search_fields": "patient_name, test_name, status",
  "title_field": "test_name",
  "sort_field": "modified", "sort_order": "DESC"
}
