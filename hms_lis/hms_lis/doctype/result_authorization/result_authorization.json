{
  "name": "Result Authorization",
  "module": "HMS LIS",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-RA-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient", "reqd": 1, "in_list_view": 1},
    {"fieldname": "patient_name", "fieldtype": "Data", "label": "Patient Name", "fetch_from": "patient.full_name", "read_only": 1},
    {"fieldname": "lab_test", "fieldtype": "Link", "label": "Lab Test", "options": "Lab Test", "reqd": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "authorized_by", "fieldtype": "Link", "label": "Authorized By", "options": "User", "reqd": 1},
    {"fieldname": "authorization_datetime", "fieldtype": "Datetime", "label": "Date/Time", "reqd": 1, "default": "Now"},
    {"fieldname": "section_result", "fieldtype": "Section Break", "label": "Result Summary"},
    {"fieldname": "result_value", "fieldtype": "Data", "label": "Result Value"},
    {"fieldname": "result_status", "fieldtype": "Select", "label": "Status", "options": "Normal\nAbnormal\nCritical", "in_list_view": 1},
    {"fieldname": "remarks", "fieldtype": "Text", "label": "Remarks"},
    {"fieldname": "release_to_portal", "fieldtype": "Check", "label": "Release to Patient Portal"}
  ],
  "permissions": [
    {"role": "Lab Supervisor", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1}
  ],
  "sort_field": "authorization_datetime", "sort_order": "DESC"
}
