{
  "name": "Final Bill",
  "module": "HMS Revenue",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-BILL-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "patient_name", "fieldtype": "Data", "label": "Patient Name", "fetch_from": "patient.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "admission", "fieldtype": "Link", "label": "Admission", "options": "Inpatient Admission"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "bill_date", "fieldtype": "Date", "label": "Bill Date", "reqd": 1, "default": "Today", "in_list_view": 1},
    {"fieldname": "bill_type", "fieldtype": "Select", "label": "Bill Type", "options": "OPD\nIPD\nEmergency\nPackage\nPharmacy", "in_standard_filter": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department"},
    {"fieldname": "branch", "fieldtype": "Link", "label": "Branch", "options": "Hospital Branch"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nPending\nPartially Paid\nPaid\nInsurance Pending\nSettled\nCancelled\nWritten Off", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "section_charges", "fieldtype": "Section Break", "label": "Charges"},
    {"fieldname": "total_charges", "fieldtype": "Currency", "label": "Total Charges", "read_only": 1, "bold": 1},
    {"fieldname": "discount_amount", "fieldtype": "Currency", "label": "Discount"},
    {"fieldname": "discount_reason", "fieldtype": "Data", "label": "Discount Reason"},
    {"fieldname": "column_break_charges", "fieldtype": "Column Break"},
    {"fieldname": "tax_amount", "fieldtype": "Currency", "label": "Tax"},
    {"fieldname": "welfare_subsidy", "fieldtype": "Currency", "label": "Welfare Subsidy", "read_only": 1},
    {"fieldname": "insurance_covered", "fieldtype": "Currency", "label": "Insurance Covered"},
    {"fieldname": "patient_payable", "fieldtype": "Currency", "label": "Patient Payable", "read_only": 1, "bold": 1, "in_list_view": 1},
    {"fieldname": "section_payment", "fieldtype": "Section Break", "label": "Payment"},
    {"fieldname": "amount_paid", "fieldtype": "Currency", "label": "Amount Paid"},
    {"fieldname": "balance_due", "fieldtype": "Currency", "label": "Balance Due", "read_only": 1},
    {"fieldname": "column_break_pay", "fieldtype": "Column Break"},
    {"fieldname": "deposit_used", "fieldtype": "Currency", "label": "Deposit Used"},
    {"fieldname": "payment_mode", "fieldtype": "Select", "label": "Payment Mode", "options": "\nCash\nCard\nOnline\nInsurance\nWelfare\nSplit"},
    {"fieldname": "section_insurance", "fieldtype": "Section Break", "label": "Insurance"},
    {"fieldname": "insurance_provider", "fieldtype": "Link", "label": "Insurance Provider", "options": "Insurance Provider"},
    {"fieldname": "authorization_number", "fieldtype": "Data", "label": "Auth Number"},
    {"fieldname": "claim_submission", "fieldtype": "Link", "label": "Claim", "options": "Claim Submission"},
    {"fieldname": "section_notes", "fieldtype": "Section Break", "label": "Notes"},
    {"fieldname": "remarks", "fieldtype": "Text", "label": "Remarks"}
  ],
  "permissions": [
    {"role": "Cashier", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1}
  ],
  "sort_field": "bill_date", "sort_order": "DESC", "title_field": "patient_name"
}
