{
  "name": "Drug Item",
  "module": "HMS Pharmacy",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "DRG-.####"},
    {"fieldname": "drug_name", "fieldtype": "Data", "label": "Drug Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "generic", "fieldtype": "Link", "label": "Generic Name", "options": "Generic", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "brand", "fieldtype": "Link", "label": "Brand", "options": "Brand"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "drug_group", "fieldtype": "Link", "label": "Drug Group", "options": "Drug Group", "in_standard_filter": 1},
    {"fieldname": "dosage_form", "fieldtype": "Link", "label": "Dosage Form", "options": "Dosage Form", "in_list_view": 1},
    {"fieldname": "strength", "fieldtype": "Link", "label": "Strength", "options": "Strength"},
    {"fieldname": "route", "fieldtype": "Link", "label": "Default Route", "options": "Route"},
    {"fieldname": "is_controlled", "fieldtype": "Check", "label": "Controlled Drug"},
    {"fieldname": "controlled_class", "fieldtype": "Link", "label": "Controlled Class", "options": "Controlled Drug Class", "depends_on": "is_controlled"},
    {"fieldname": "section_inventory", "fieldtype": "Section Break", "label": "Inventory"},
    {"fieldname": "uom", "fieldtype": "Data", "label": "UOM", "default": "Nos"},
    {"fieldname": "pack_size", "fieldtype": "Int", "label": "Pack Size", "default": 1},
    {"fieldname": "reorder_level", "fieldtype": "Int", "label": "Reorder Level"},
    {"fieldname": "column_break_inv", "fieldtype": "Column Break"},
    {"fieldname": "mrp", "fieldtype": "Currency", "label": "MRP", "in_list_view": 1},
    {"fieldname": "selling_price", "fieldtype": "Currency", "label": "Selling Price"},
    {"fieldname": "purchase_price", "fieldtype": "Currency", "label": "Purchase Price"},
    {"fieldname": "current_stock", "fieldtype": "Float", "label": "Current Stock", "read_only": 1},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": 1},
    {"fieldname": "section_supplier", "fieldtype": "Section Break", "label": "Supplier"},
    {"fieldname": "default_supplier", "fieldtype": "Link", "label": "Default Supplier", "options": "Supplier"},
    {"fieldname": "manufacturer", "fieldtype": "Data", "label": "Manufacturer"},
    {"fieldname": "barcode", "fieldtype": "Data", "label": "Barcode"}
  ],
  "permissions": [
    {"role": "Pharmacist", "read": 1, "write": 1, "create": 1},
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "search_fields": "drug_name, generic",
  "title_field": "drug_name",
  "sort_field": "modified", "sort_order": "DESC"
}
