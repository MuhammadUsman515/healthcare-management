{
  "name": "Practitioner",
  "module": "HMS Clinical",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-PRAC-.YYYY.-.#####",
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {"fieldname": "first_name", "fieldtype": "Data", "label": "First Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "last_name", "fieldtype": "Data", "label": "Last Name"},
    {"fieldname": "full_name", "fieldtype": "Data", "label": "Full Name", "read_only": 1, "bold": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "gender", "fieldtype": "Link", "label": "Gender", "options": "Gender"},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "branch", "fieldtype": "Link", "label": "Branch", "options": "Hospital Branch", "in_standard_filter": 1},
    {"fieldname": "designation", "fieldtype": "Data", "label": "Designation"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nOn Leave\nDisabled", "default": "Active", "in_standard_filter": 1},
    {"fieldname": "image", "fieldtype": "Attach Image", "label": "Photo"},
    {"fieldname": "section_qualifications", "fieldtype": "Section Break", "label": "Qualifications & License"},
    {"fieldname": "medical_license_number", "fieldtype": "Data", "label": "License Number"},
    {"fieldname": "license_expiry", "fieldtype": "Date", "label": "License Expiry"},
    {"fieldname": "specialization", "fieldtype": "Data", "label": "Specialization", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "sub_specialization", "fieldtype": "Data", "label": "Sub-Specialization"},
    {"fieldname": "column_break_qual", "fieldtype": "Column Break"},
    {"fieldname": "qualification", "fieldtype": "Small Text", "label": "Qualification"},
    {"fieldname": "experience_years", "fieldtype": "Int", "label": "Years of Experience"},
    {"fieldname": "consultation_fee", "fieldtype": "Currency", "label": "Consultation Fee"},
    {"fieldname": "follow_up_fee", "fieldtype": "Currency", "label": "Follow-Up Fee"},
    {"fieldname": "section_schedule", "fieldtype": "Section Break", "label": "Schedule"},
    {"fieldname": "available_days", "fieldtype": "Small Text", "label": "Available Days"},
    {"fieldname": "max_patients_per_day", "fieldtype": "Int", "label": "Max Patients Per Day", "default": 30},
    {"fieldname": "avg_consultation_time", "fieldtype": "Int", "label": "Avg Consultation Time (min)", "default": 15},
    {"fieldname": "section_contact", "fieldtype": "Section Break", "label": "Contact"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "mobile", "fieldtype": "Data", "label": "Mobile", "options": "Phone"},
    {"fieldname": "user", "fieldtype": "Link", "label": "Linked User", "options": "User"},
    {"fieldname": "section_commission", "fieldtype": "Section Break", "label": "Commission"},
    {"fieldname": "commission_type", "fieldtype": "Select", "label": "Commission Type", "options": "\nFixed\nPercentage"},
    {"fieldname": "commission_rate", "fieldtype": "Float", "label": "Commission Rate"}
  ],
  "permissions": [
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Physician", "read": 1}
  ],
  "search_fields": "full_name, specialization, department",
  "title_field": "full_name", "image_field": "image",
  "sort_field": "modified", "sort_order": "DESC"
}
