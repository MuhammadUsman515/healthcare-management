{
  "name": "Appointment",
  "module": "HMS Clinical",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-APT-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "patient_name", "fieldtype": "Data", "label": "Patient Name", "fetch_from": "patient.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "patient_age", "fieldtype": "Data", "label": "Age", "fetch_from": "patient.age_display", "read_only": 1},
    {"fieldname": "patient_gender", "fieldtype": "Data", "label": "Gender", "fetch_from": "patient.gender", "read_only": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "practitioner", "fieldtype": "Link", "label": "Practitioner", "options": "Practitioner", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "practitioner_name", "fieldtype": "Data", "label": "Practitioner Name", "fetch_from": "practitioner.full_name", "read_only": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department", "in_standard_filter": 1},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company"},
    {"fieldname": "branch", "fieldtype": "Link", "label": "Branch", "options": "Hospital Branch", "in_standard_filter": 1},
    {"fieldname": "section_schedule", "fieldtype": "Section Break", "label": "Schedule"},
    {"fieldname": "appointment_date", "fieldtype": "Date", "label": "Appointment Date", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "appointment_time", "fieldtype": "Time", "label": "Appointment Time", "reqd": 1},
    {"fieldname": "duration", "fieldtype": "Int", "label": "Duration (minutes)", "default": 15},
    {"fieldname": "column_break_schedule", "fieldtype": "Column Break"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Scheduled\nChecked In\nIn Consultation\nCompleted\nCancelled\nNo Show\nRescheduled", "default": "Scheduled", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "appointment_type", "fieldtype": "Select", "label": "Type", "options": "New Consultation\nFollow Up\nEmergency\nRoutine Checkup\nProcedure\nTeleconsult", "default": "New Consultation"},
    {"fieldname": "priority", "fieldtype": "Select", "label": "Priority", "options": "Normal\nUrgent\nEmergency", "default": "Normal"},
    {"fieldname": "token_number", "fieldtype": "Int", "label": "Token No", "read_only": 1},
    {"fieldname": "section_clinical", "fieldtype": "Section Break", "label": "Clinical"},
    {"fieldname": "reason", "fieldtype": "Small Text", "label": "Reason for Visit"},
    {"fieldname": "referring_practitioner", "fieldtype": "Link", "label": "Referring Practitioner", "options": "Practitioner"},
    {"fieldname": "referral_letter", "fieldtype": "Link", "label": "Referral Letter", "options": "Referral Letter"},
    {"fieldname": "column_break_clinical", "fieldtype": "Column Break"},
    {"fieldname": "insurance_provider", "fieldtype": "Link", "label": "Insurance", "options": "Insurance Provider"},
    {"fieldname": "coverage_plan", "fieldtype": "Link", "label": "Coverage Plan", "options": "Coverage Plan"},
    {"fieldname": "authorization_number", "fieldtype": "Data", "label": "Authorization Number"},
    {"fieldname": "section_billing", "fieldtype": "Section Break", "label": "Billing"},
    {"fieldname": "billing_status", "fieldtype": "Select", "label": "Billing Status", "options": "Pending\nInvoiced\nPaid\nWaived", "default": "Pending"},
    {"fieldname": "consultation_charge", "fieldtype": "Currency", "label": "Consultation Charge"},
    {"fieldname": "section_notes", "fieldtype": "Section Break", "label": "Notes"},
    {"fieldname": "notes", "fieldtype": "Text", "label": "Notes"},
    {"fieldname": "cancellation_reason", "fieldtype": "Small Text", "label": "Cancellation Reason", "depends_on": "eval:doc.status=='Cancelled'"}
  ],
  "permissions": [
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Physician", "read": 1, "write": 1, "create": 1},
    {"role": "Nurse", "read": 1, "write": 1, "create": 1}
  ],
  "search_fields": "patient_name, practitioner_name, appointment_date",
  "title_field": "patient_name",
  "sort_field": "appointment_date",
  "sort_order": "DESC"
}
