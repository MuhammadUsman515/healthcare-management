{
  "name": "Inpatient Admission",
  "module": "HMS Clinical",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-ADM-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "patient_name", "fieldtype": "Data", "label": "Patient Name", "fetch_from": "patient.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "admission_date", "fieldtype": "Datetime", "label": "Admission Date", "reqd": 1, "default": "Now", "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "primary_practitioner", "fieldtype": "Link", "label": "Primary Practitioner", "options": "Practitioner", "reqd": 1, "in_standard_filter": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department", "in_standard_filter": 1},
    {"fieldname": "encounter", "fieldtype": "Link", "label": "Source Encounter", "options": "Encounter"},
    {"fieldname": "admission_request", "fieldtype": "Link", "label": "Admission Request", "options": "Admission Request"},
    {"fieldname": "section_bed", "fieldtype": "Section Break", "label": "Bed Assignment"},
    {"fieldname": "ward", "fieldtype": "Link", "label": "Ward", "options": "Ward", "in_standard_filter": 1},
    {"fieldname": "bed", "fieldtype": "Link", "label": "Bed", "options": "Bed"},
    {"fieldname": "bed_class", "fieldtype": "Link", "label": "Bed Class", "options": "Bed Class"},
    {"fieldname": "column_break_bed", "fieldtype": "Column Break"},
    {"fieldname": "isolation_type", "fieldtype": "Link", "label": "Isolation Type", "options": "Isolation Type"},
    {"fieldname": "expected_discharge", "fieldtype": "Date", "label": "Expected Discharge Date"},
    {"fieldname": "section_clinical", "fieldtype": "Section Break", "label": "Clinical"},
    {"fieldname": "admission_reason", "fieldtype": "Small Text", "label": "Reason for Admission", "reqd": 1},
    {"fieldname": "provisional_diagnosis", "fieldtype": "Small Text", "label": "Provisional Diagnosis"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Admitted\nTransferred\nDischarge Initiated\nBilling Clearance\nDischarged\nLAMA\nExpired\nCancelled", "default": "Admitted", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "column_break_clin", "fieldtype": "Column Break"},
    {"fieldname": "diet_plan", "fieldtype": "Small Text", "label": "Diet Plan"},
    {"fieldname": "activity_restriction", "fieldtype": "Small Text", "label": "Activity Restrictions"},
    {"fieldname": "section_insurance", "fieldtype": "Section Break", "label": "Insurance"},
    {"fieldname": "insurance_provider", "fieldtype": "Link", "label": "Insurance Provider", "options": "Insurance Provider"},
    {"fieldname": "preauth_number", "fieldtype": "Data", "label": "Pre-Auth Number"},
    {"fieldname": "approved_amount", "fieldtype": "Currency", "label": "Approved Amount"},
    {"fieldname": "section_discharge", "fieldtype": "Section Break", "label": "Discharge"},
    {"fieldname": "actual_discharge", "fieldtype": "Datetime", "label": "Actual Discharge Date"},
    {"fieldname": "discharge_summary", "fieldtype": "Link", "label": "Discharge Summary", "options": "Discharge Summary"},
    {"fieldname": "length_of_stay", "fieldtype": "Int", "label": "Length of Stay (Days)", "read_only": 1}
  ],
  "permissions": [
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1},
    {"role": "Physician", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Nurse", "read": 1, "write": 1}
  ],
  "search_fields": "patient_name, status, ward",
  "title_field": "patient_name",
  "sort_field": "admission_date",
  "sort_order": "DESC"
}
