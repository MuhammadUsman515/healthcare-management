{
  "name": "Bed",
  "module": "HMS Clinical",
  "doctype": "DocType",
  "naming_rule": "Set by user",
  "engine": "InnoDB",
  "fields": [
    {"fieldname": "bed_name", "fieldtype": "Data", "label": "Bed Name/Number", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "ward", "fieldtype": "Link", "label": "Ward", "options": "Ward", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "bed_class", "fieldtype": "Link", "label": "Bed Class", "options": "Bed Class"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Available\nOccupied\nReserved\nMaintenance\nBlocked", "default": "Available", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "current_patient", "fieldtype": "Link", "label": "Current Patient", "options": "Patient", "read_only": 1},
    {"fieldname": "charge_per_day", "fieldtype": "Currency", "label": "Charge Per Day"}
  ],
  "permissions": [{"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "delete": 1}, {"role": "Nurse", "read": 1, "write": 1}],
  "sort_field": "modified", "sort_order": "DESC", "title_field": "bed_name"
}
