{
 "name": "Queue Token",
 "module": "HMS Clinical",
 "doctype": "DocType",
 "naming_rule": "Expression",
 "autoname": "TKN-.YYYY.-.#####",
 "title_field": "patient_name",
 "search_fields": "patient_name, token_number",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "in_list_view": 1
  },
  {
   "fieldname": "patient",
   "fieldtype": "Link",
   "label": "Patient",
   "options": "Patient",
   "in_standard_filter": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Text",
   "label": "Description"
  },
  {
   "fieldname": "appointment",
   "fieldtype": "Link",
   "label": "Appointment",
   "options": "Appointment",
   "in_standard_filter": 1
  },
  {
   "fieldname": "token_number",
   "fieldtype": "Int",
   "label": "Token Number",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "patient_name",
   "fieldtype": "Data",
   "label": "Patient Name",
   "fetch_from": "patient.full_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "service_unit",
   "fieldtype": "Link",
   "label": "Service Unit",
   "options": "Service Unit"
  },
  {
   "fieldname": "department",
   "fieldtype": "Link",
   "label": "Department",
   "options": "Department"
  },
  {
   "fieldname": "appointment_type",
   "fieldtype": "Data",
   "label": "Appointment Type",
   "fetch_from": "appointment.appointment_type",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nInactive\nCompleted\nCancelled",
   "default": "Active",
   "in_list_view": 1
  },
  {
   "fieldname": "date",
   "fieldtype": "Date",
   "label": "Date",
   "default": "Today"
  },
  {
   "fieldname": "practitioner",
   "fieldtype": "Link",
   "label": "Practitioner",
   "options": "Practitioner"
  }
 ],
 "permissions": [
  {
   "role": "Healthcare Administrator",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Physician",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Nurse",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}