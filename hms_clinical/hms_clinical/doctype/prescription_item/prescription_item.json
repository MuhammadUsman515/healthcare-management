{
  "name": "Prescription Item",
  "module": "HMS Clinical",
  "doctype": "DocType",
  "istable": 1,
  "engine": "InnoDB",
  "fields": [
    {"fieldname": "drug_name", "fieldtype": "Data", "label": "Drug Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "generic_name", "fieldtype": "Data", "label": "Generic Name"},
    {"fieldname": "dosage", "fieldtype": "Data", "label": "Dosage", "reqd": 1, "in_list_view": 1},
    {"fieldname": "dosage_form", "fieldtype": "Select", "label": "Form", "options": "\nTablet\nCapsule\nSyrup\nInjection\nCream\nOintment\nDrops\nInhaler\nSuppository\nOther"},
    {"fieldname": "route", "fieldtype": "Select", "label": "Route", "options": "\nOral\nIV\nIM\nSC\nTopical\nSublingual\nRectal\nInhalation\nOther"},
    {"fieldname": "frequency", "fieldtype": "Select", "label": "Frequency", "options": "\nOD (Once daily)\nBD (Twice daily)\nTDS (Three times daily)\nQDS (Four times daily)\nQ6H\nQ8H\nQ12H\nPRN (As needed)\nHS (At bedtime)\nStat (Immediately)", "in_list_view": 1},
    {"fieldname": "duration", "fieldtype": "Int", "label": "Duration (days)", "in_list_view": 1},
    {"fieldname": "quantity", "fieldtype": "Int", "label": "Quantity"},
    {"fieldname": "instructions", "fieldtype": "Small Text", "label": "Instructions"},
    {"fieldname": "is_dispensed", "fieldtype": "Check", "label": "Dispensed"}
  ],
  "permissions": []
}
