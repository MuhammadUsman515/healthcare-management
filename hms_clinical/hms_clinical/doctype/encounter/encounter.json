{
  "name": "Encounter",
  "module": "HMS Clinical",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-ENC-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "patient_name", "fieldtype": "Data", "label": "Patient Name", "fetch_from": "patient.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "patient_age", "fieldtype": "Data", "label": "Age", "fetch_from": "patient.age_display", "read_only": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "practitioner", "fieldtype": "Link", "label": "Practitioner", "options": "Practitioner", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "practitioner_name", "fieldtype": "Data", "label": "Practitioner Name", "fetch_from": "practitioner.full_name", "read_only": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department", "in_standard_filter": 1},
    {"fieldname": "appointment", "fieldtype": "Link", "label": "Appointment", "options": "Appointment"},
    {"fieldname": "encounter_date", "fieldtype": "Date", "label": "Date", "reqd": 1, "default": "Today", "in_list_view": 1},
    {"fieldname": "encounter_time", "fieldtype": "Time", "label": "Time", "default": "Now"},
    {"fieldname": "encounter_type", "fieldtype": "Select", "label": "Type", "options": "OPD\nIPD\nEmergency\nTeleconsult", "default": "OPD"},
    {"fieldname": "section_subjective", "fieldtype": "Section Break", "label": "Subjective (History)"},
    {"fieldname": "chief_complaints", "fieldtype": "Small Text", "label": "Chief Complaints"},
    {"fieldname": "history_of_present_illness", "fieldtype": "Text", "label": "History of Present Illness"},
    {"fieldname": "review_of_systems", "fieldtype": "Text", "label": "Review of Systems"},
    {"fieldname": "section_objective", "fieldtype": "Section Break", "label": "Objective (Examination)"},
    {"fieldname": "general_examination", "fieldtype": "Small Text", "label": "General Examination"},
    {"fieldname": "systemic_examination", "fieldtype": "Text", "label": "Systemic Examination"},
    {"fieldname": "section_assessment", "fieldtype": "Section Break", "label": "Assessment"},
    {"fieldname": "provisional_diagnosis", "fieldtype": "Small Text", "label": "Provisional Diagnosis"},
    {"fieldname": "final_diagnosis", "fieldtype": "Small Text", "label": "Final Diagnosis"},
    {"fieldname": "icd_code", "fieldtype": "Data", "label": "ICD-10 Code"},
    {"fieldname": "section_plan", "fieldtype": "Section Break", "label": "Plan"},
    {"fieldname": "treatment_plan", "fieldtype": "Text", "label": "Treatment Plan"},
    {"fieldname": "lab_orders_text", "fieldtype": "Small Text", "label": "Lab Orders Summary"},
    {"fieldname": "radiology_orders_text", "fieldtype": "Small Text", "label": "Radiology Orders Summary"},
    {"fieldname": "procedure_orders_text", "fieldtype": "Small Text", "label": "Procedure Orders Summary"},
    {"fieldname": "column_break_plan", "fieldtype": "Column Break"},
    {"fieldname": "follow_up_date", "fieldtype": "Date", "label": "Follow Up Date"},
    {"fieldname": "follow_up_notes", "fieldtype": "Small Text", "label": "Follow Up Notes"},
    {"fieldname": "referral_to", "fieldtype": "Link", "label": "Refer To", "options": "Practitioner"},
    {"fieldname": "referral_department", "fieldtype": "Link", "label": "Refer to Department", "options": "Department"},
    {"fieldname": "admit_patient", "fieldtype": "Check", "label": "Admit Patient"},
    {"fieldname": "section_addendum", "fieldtype": "Section Break", "label": "Addendum"},
    {"fieldname": "addendum", "fieldtype": "Text", "label": "Addendum Notes"},
    {"fieldname": "addendum_date", "fieldtype": "Datetime", "label": "Addendum Date"}
  ],
  "permissions": [
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1},
    {"role": "Physician", "read": 1, "write": 1, "create": 1, "submit": 1}
  ],
  "search_fields": "patient_name, practitioner_name, encounter_date",
  "title_field": "patient_name",
  "sort_field": "encounter_date",
  "sort_order": "DESC"
}
