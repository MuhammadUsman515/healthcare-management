{
  "name": "Patient",
  "module": "HMS Clinical",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-PAT-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 0,
  "allow_rename": 0,
  "track_changes": 1,
  "fields": [
    {"fieldname": "first_name", "fieldtype": "Data", "label": "First Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "middle_name", "fieldtype": "Data", "label": "Middle Name"},
    {"fieldname": "last_name", "fieldtype": "Data", "label": "Last Name", "in_list_view": 1},
    {"fieldname": "full_name", "fieldtype": "Data", "label": "Full Name", "read_only": 1, "bold": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "gender", "fieldtype": "Link", "label": "Gender", "options": "Gender", "reqd": 1, "in_standard_filter": 1},
    {"fieldname": "dob", "fieldtype": "Date", "label": "Date of Birth"},
    {"fieldname": "age_display", "fieldtype": "Data", "label": "Age", "read_only": 1},
    {"fieldname": "blood_group", "fieldtype": "Select", "label": "Blood Group", "options": "\nA+\nA-\nB+\nB-\nAB+\nAB-\nO+\nO-"},
    {"fieldname": "marital_status", "fieldtype": "Select", "label": "Marital Status", "options": "\nSingle\nMarried\nDivorced\nWidowed"},
    {"fieldname": "image", "fieldtype": "Attach Image", "label": "Photo"},
    {"fieldname": "section_identity", "fieldtype": "Section Break", "label": "Identity & Registration"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nDisabled\nDeceased\nMerged", "default": "Active", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "registration_date", "fieldtype": "Date", "label": "Registration Date", "default": "Today"},
    {"fieldname": "cnic", "fieldtype": "Data", "label": "CNIC / National ID"},
    {"fieldname": "passport_no", "fieldtype": "Data", "label": "Passport No"},
    {"fieldname": "column_break_identity", "fieldtype": "Column Break"},
    {"fieldname": "mrn", "fieldtype": "Data", "label": "MRN (Medical Record Number)", "read_only": 1},
    {"fieldname": "company", "fieldtype": "Link", "label": "Registered At", "options": "Company"},
    {"fieldname": "branch", "fieldtype": "Link", "label": "Branch", "options": "Hospital Branch", "in_standard_filter": 1},
    {"fieldname": "referral_source", "fieldtype": "Link", "label": "Referral Source", "options": "Referral Source"},
    {"fieldname": "section_flags", "fieldtype": "Section Break", "label": "Alert Flags"},
    {"fieldname": "is_vip", "fieldtype": "Check", "label": "VIP"},
    {"fieldname": "is_medico_legal", "fieldtype": "Check", "label": "Medico-Legal Case"},
    {"fieldname": "is_infection_risk", "fieldtype": "Check", "label": "Infection Risk"},
    {"fieldname": "is_high_risk", "fieldtype": "Check", "label": "High Risk Patient"},
    {"fieldname": "column_break_flags", "fieldtype": "Column Break"},
    {"fieldname": "flag_notes", "fieldtype": "Small Text", "label": "Flag Notes"},
    {"fieldname": "section_contact", "fieldtype": "Section Break", "label": "Contact Details"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "mobile", "fieldtype": "Data", "label": "Mobile", "options": "Phone", "in_list_view": 1},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Phone", "options": "Phone"},
    {"fieldname": "column_break_contact", "fieldtype": "Column Break"},
    {"fieldname": "address_line_1", "fieldtype": "Data", "label": "Address Line 1"},
    {"fieldname": "address_line_2", "fieldtype": "Data", "label": "Address Line 2"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City"},
    {"fieldname": "state", "fieldtype": "Data", "label": "State"},
    {"fieldname": "section_emergency", "fieldtype": "Section Break", "label": "Emergency Contact"},
    {"fieldname": "emergency_contact_name", "fieldtype": "Data", "label": "Emergency Contact Name"},
    {"fieldname": "emergency_contact_relation", "fieldtype": "Data", "label": "Relation"},
    {"fieldname": "emergency_contact_phone", "fieldtype": "Data", "label": "Emergency Phone", "options": "Phone"},
    {"fieldname": "section_insurance", "fieldtype": "Section Break", "label": "Insurance / Panel"},
    {"fieldname": "insurance_provider", "fieldtype": "Link", "label": "Insurance Provider", "options": "Insurance Provider"},
    {"fieldname": "coverage_plan", "fieldtype": "Link", "label": "Coverage Plan", "options": "Coverage Plan"},
    {"fieldname": "policy_number", "fieldtype": "Data", "label": "Policy / Card Number"},
    {"fieldname": "column_break_ins", "fieldtype": "Column Break"},
    {"fieldname": "employer", "fieldtype": "Data", "label": "Employer / Corporate"},
    {"fieldname": "employee_id", "fieldtype": "Data", "label": "Employee ID"},
    {"fieldname": "section_medical", "fieldtype": "Section Break", "label": "Medical History"},
    {"fieldname": "allergies", "fieldtype": "Small Text", "label": "Allergies"},
    {"fieldname": "chronic_conditions", "fieldtype": "Small Text", "label": "Chronic Conditions"},
    {"fieldname": "column_break_med", "fieldtype": "Column Break"},
    {"fieldname": "current_medication", "fieldtype": "Small Text", "label": "Current Medication"},
    {"fieldname": "surgical_history", "fieldtype": "Small Text", "label": "Surgical History"},
    {"fieldname": "medical_history", "fieldtype": "Text", "label": "Detailed Medical History"},
    {"fieldname": "section_portal", "fieldtype": "Section Break", "label": "Portal Access"},
    {"fieldname": "user", "fieldtype": "Link", "label": "Linked User", "options": "User"},
    {"fieldname": "portal_enabled", "fieldtype": "Check", "label": "Portal Access Enabled"}
  ],
  "permissions": [
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Physician", "read": 1, "write": 1, "create": 1},
    {"role": "Nurse", "read": 1, "write": 1},
    {"role": "Cashier", "read": 1},
    {"role": "Lab Technician", "read": 1}
  ],
  "search_fields": "full_name, mobile, cnic, email",
  "title_field": "full_name",
  "image_field": "image",
  "sort_field": "modified",
  "sort_order": "DESC"
}
