{
  "name": "Ward",
  "module": "HMS Clinical",
  "doctype": "DocType",
  "naming_rule": "Set by user",
  "engine": "InnoDB",
  "fields": [
    {"fieldname": "ward_name", "fieldtype": "Data", "label": "Ward Name", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "branch", "fieldtype": "Link", "label": "Branch", "options": "Hospital Branch", "in_standard_filter": 1},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "ward_type", "fieldtype": "Select", "label": "Type", "options": "General\nSemi-Private\nPrivate\nICU\nNICU\nPICU\nCCU\nIsolation\nEmergency", "in_list_view": 1},
    {"fieldname": "total_beds", "fieldtype": "Int", "label": "Total Beds", "in_list_view": 1},
    {"fieldname": "occupied_beds", "fieldtype": "Int", "label": "Occupied Beds", "read_only": 1, "in_list_view": 1},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": 1},
    {"fieldname": "charge_per_day", "fieldtype": "Currency", "label": "Charge Per Day"}
  ],
  "permissions": [{"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "delete": 1}, {"role": "Nurse", "read": 1}],
  "sort_field": "modified", "sort_order": "DESC", "title_field": "ward_name"
}
