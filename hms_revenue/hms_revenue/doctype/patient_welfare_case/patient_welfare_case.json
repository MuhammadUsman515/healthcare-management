{
  "name": "Patient Welfare Case",
  "module": "HMS Revenue",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "WLF-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "patient_name", "fieldtype": "Data", "label": "Patient Name", "fetch_from": "patient.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "case_date", "fieldtype": "Date", "label": "Case Date", "reqd": 1, "default": "Today"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "welfare_officer", "fieldtype": "Link", "label": "Welfare Officer", "options": "User", "reqd": 1},
    {"fieldname": "category", "fieldtype": "Link", "label": "Category", "options": "Zakat Sadaqah Category"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nSubmitted\nDocuments Verified\nSocial Assessment Done\nCommittee Review\nApproved\nRejected\nSubsidy Allocated\nApplied to Bill\nClosed", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "section_assessment", "fieldtype": "Section Break", "label": "Assessment"},
    {"fieldname": "monthly_income", "fieldtype": "Currency", "label": "Monthly Income"},
    {"fieldname": "family_size", "fieldtype": "Int", "label": "Family Size"},
    {"fieldname": "employment_status", "fieldtype": "Select", "label": "Employment", "options": "\nEmployed\nSelf-Employed\nUnemployed\nRetired\nDisabled"},
    {"fieldname": "social_assessment", "fieldtype": "Text", "label": "Social Assessment"},
    {"fieldname": "column_break_assess", "fieldtype": "Column Break"},
    {"fieldname": "requested_amount", "fieldtype": "Currency", "label": "Requested Amount", "in_list_view": 1},
    {"fieldname": "approved_amount", "fieldtype": "Currency", "label": "Approved Amount"},
    {"fieldname": "fund_source", "fieldtype": "Link", "label": "Fund Source", "options": "Donation Fund"},
    {"fieldname": "final_bill", "fieldtype": "Link", "label": "Related Bill", "options": "Final Bill"},
    {"fieldname": "section_documents", "fieldtype": "Section Break", "label": "Required Documents"},
    {"fieldname": "cnic_verified", "fieldtype": "Check", "label": "CNIC Verified"},
    {"fieldname": "income_proof", "fieldtype": "Check", "label": "Income Proof Submitted"},
    {"fieldname": "medical_report", "fieldtype": "Check", "label": "Medical Report Attached"},
    {"fieldname": "documents_complete", "fieldtype": "Check", "label": "All Documents Complete", "read_only": 1},
    {"fieldname": "section_committee", "fieldtype": "Section Break", "label": "Committee Decision"},
    {"fieldname": "committee_date", "fieldtype": "Date", "label": "Committee Date"},
    {"fieldname": "committee_decision", "fieldtype": "Select", "label": "Decision", "options": "\nApproved\nPartially Approved\nRejected\nDeferred"},
    {"fieldname": "committee_remarks", "fieldtype": "Text", "label": "Committee Remarks"}
  ],
  "permissions": [
    {"role": "Welfare Officer", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Welfare Committee", "read": 1, "write": 1},
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1}
  ],
  "sort_field": "case_date", "sort_order": "DESC", "title_field": "patient_name"
}
