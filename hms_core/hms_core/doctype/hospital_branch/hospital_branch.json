{
  "name": "Hospital Branch",
  "module": "HMS Core",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "label": "Naming Series", "options": "HB-.####", "reqd": 1},
    {"fieldname": "branch_name", "fieldtype": "Data", "label": "Branch Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1, "in_standard_filter": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "branch_type", "fieldtype": "Select", "label": "Branch Type", "options": "Hospital\nClinic\nDiagnostic Center\nPharmacy Outlet\nRehab Center", "default": "Hospital"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Is Active", "default": 1, "in_list_view": 1},
    {"fieldname": "section_location", "fieldtype": "Section Break", "label": "Location"},
    {"fieldname": "address", "fieldtype": "Small Text", "label": "Address"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City", "in_standard_filter": 1},
    {"fieldname": "column_break_loc", "fieldtype": "Column Break"},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Phone", "options": "Phone"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "branch_head", "fieldtype": "Link", "label": "Branch Head", "options": "User"}
  ],
  "permissions": [
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Hospital Admin", "read": 1, "write": 1, "create": 1},
    {"role": "Branch Admin", "read": 1, "write": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "branch_name"
}
