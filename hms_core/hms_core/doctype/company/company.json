{
  "name": "Company",
  "module": "HMS Core",
  "doctype": "DocType",
  "naming_rule": "Set by user",
  "engine": "InnoDB",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {"fieldname": "company_name", "fieldtype": "Data", "label": "Company Name", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "abbr", "fieldtype": "Data", "label": "Abbreviation", "reqd": 1, "unique": 1},
    {"fieldname": "domain", "fieldtype": "Select", "label": "Domain", "options": "Healthcare\nDiagnostics\nPharmacy\nMulti-specialty", "default": "Healthcare"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "country", "fieldtype": "Data", "label": "Country", "reqd": 1},
    {"fieldname": "default_currency", "fieldtype": "Data", "label": "Default Currency", "reqd": 1, "default": "PKR"},
    {"fieldname": "logo", "fieldtype": "Attach Image", "label": "Logo"},
    {"fieldname": "section_address", "fieldtype": "Section Break", "label": "Address"},
    {"fieldname": "address_line_1", "fieldtype": "Data", "label": "Address Line 1"},
    {"fieldname": "address_line_2", "fieldtype": "Data", "label": "Address Line 2"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City"},
    {"fieldname": "column_break_addr", "fieldtype": "Column Break"},
    {"fieldname": "state", "fieldtype": "Data", "label": "State"},
    {"fieldname": "pincode", "fieldtype": "Data", "label": "PIN Code"},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Phone", "options": "Phone"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "website", "fieldtype": "Data", "label": "Website"}
  ],
  "permissions": [
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Hospital Admin", "read": 1, "write": 1, "create": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "company_name"
}
