{
  "name": "Insurance Provider",
  "module": "HMS Core",
  "doctype": "DocType",
  "naming_rule": "Set by user",
  "engine": "InnoDB",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {"fieldname": "provider_name", "fieldtype": "Data", "label": "Provider Name", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "provider_type", "fieldtype": "Select", "label": "Type", "options": "Insurance\nTPA\nCorporate Panel\nGovernment Scheme", "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "contact_person", "fieldtype": "Data", "label": "Contact Person"},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Phone", "options": "Phone"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Is Active", "default": 1, "in_list_view": 1},
    {"fieldname": "section_contract", "fieldtype": "Section Break", "label": "Contract Details"},
    {"fieldname": "contract_start", "fieldtype": "Date", "label": "Contract Start"},
    {"fieldname": "contract_end", "fieldtype": "Date", "label": "Contract End"},
    {"fieldname": "discount_percentage", "fieldtype": "Percent", "label": "Default Discount %"},
    {"fieldname": "credit_limit", "fieldtype": "Currency", "label": "Credit Limit"},
    {"fieldname": "payment_terms_days", "fieldtype": "Int", "label": "Payment Terms (Days)", "default": 30},
    {"fieldname": "address", "fieldtype": "Small Text", "label": "Address"}
  ],
  "permissions": [
    {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Cashier", "read": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "provider_name"
}
