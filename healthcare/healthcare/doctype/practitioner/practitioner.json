{
  "name": "Practitioner",
  "module": "Healthcare",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-PRAC-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "first_name",
      "fieldtype": "Data",
      "label": "First Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "last_name",
      "fieldtype": "Data",
      "label": "Last Name",
      "in_list_view": 1
    },
    {
      "fieldname": "full_name",
      "fieldtype": "Data",
      "label": "Full Name",
      "read_only": 1,
      "bold": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "gender",
      "fieldtype": "Link",
      "label": "Gender",
      "options": "Gender"
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Medical Department",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "designation",
      "fieldtype": "Data",
      "label": "Designation"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Active\nDisabled",
      "default": "Active",
      "in_standard_filter": 1
    },
    {
      "fieldname": "section_qualifications",
      "fieldtype": "Section Break",
      "label": "Qualifications"
    },
    {
      "fieldname": "medical_license_number",
      "fieldtype": "Data",
      "label": "Medical License Number"
    },
    {
      "fieldname": "specialization",
      "fieldtype": "Data",
      "label": "Specialization",
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_qual",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "experience_years",
      "fieldtype": "Int",
      "label": "Years of Experience"
    },
    {
      "fieldname": "qualification",
      "fieldtype": "Small Text",
      "label": "Qualification"
    },
    {
      "fieldname": "section_contact",
      "fieldtype": "Section Break",
      "label": "Contact"
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email",
      "options": "Email"
    },
    {
      "fieldname": "mobile",
      "fieldtype": "Data",
      "label": "Mobile",
      "options": "Phone"
    }
  ],
  "permissions": [
    {
      "role": "Healthcare Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Physician",
      "read": 1
    }
  ],
  "search_fields": "full_name, specialization, department",
  "title_field": "full_name",
  "sort_field": "modified",
  "sort_order": "DESC"
}
