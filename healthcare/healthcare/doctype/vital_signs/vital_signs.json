{
  "name": "Vital Signs",
  "module": "Healthcare",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-VIT-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "patient",
      "fieldtype": "Link",
      "label": "Patient",
      "options": "Patient",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "patient_name",
      "fieldtype": "Data",
      "label": "Patient Name",
      "fetch_from": "patient.full_name",
      "read_only": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "encounter_date",
      "fieldtype": "Date",
      "label": "Date",
      "reqd": 1,
      "default": "Today",
      "in_list_view": 1
    },
    {
      "fieldname": "practitioner",
      "fieldtype": "Link",
      "label": "Practitioner",
      "options": "Practitioner"
    },
    {
      "fieldname": "section_vitals",
      "fieldtype": "Section Break",
      "label": "Vital Signs"
    },
    {
      "fieldname": "temperature",
      "fieldtype": "Float",
      "label": "Temperature (°F)",
      "in_list_view": 1
    },
    {
      "fieldname": "heart_rate",
      "fieldtype": "Int",
      "label": "Heart Rate (bpm)",
      "in_list_view": 1
    },
    {
      "fieldname": "respiratory_rate",
      "fieldtype": "Int",
      "label": "Respiratory Rate (breaths/min)"
    },
    {
      "fieldname": "column_break_vitals",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "bp_systolic",
      "fieldtype": "Int",
      "label": "BP Systolic (mmHg)",
      "in_list_view": 1
    },
    {
      "fieldname": "bp_diastolic",
      "fieldtype": "Int",
      "label": "BP Diastolic (mmHg)",
      "in_list_view": 1
    },
    {
      "fieldname": "oxygen_saturation",
      "fieldtype": "Float",
      "label": "Oxygen Saturation (%)"
    },
    {
      "fieldname": "section_body",
      "fieldtype": "Section Break",
      "label": "Body Measurements"
    },
    {
      "fieldname": "height",
      "fieldtype": "Float",
      "label": "Height (cm)"
    },
    {
      "fieldname": "weight",
      "fieldtype": "Float",
      "label": "Weight (kg)"
    },
    {
      "fieldname": "bmi",
      "fieldtype": "Float",
      "label": "BMI",
      "read_only": 1
    },
    {
      "fieldname": "section_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "Healthcare Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "delete": 1
    },
    {
      "role": "Physician",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1
    }
  ],
  "search_fields": "patient_name, encounter_date",
  "title_field": "patient_name",
  "sort_field": "encounter_date",
  "sort_order": "DESC"
}
