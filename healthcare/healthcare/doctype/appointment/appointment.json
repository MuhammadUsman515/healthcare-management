{
  "name": "Appointment",
  "module": "Healthcare",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "HLC-APT-.YYYY.-.#####",
  "engine": "InnoDB",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "patient",
      "fieldtype": "Link",
      "label": "Patient",
      "options": "Patient",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "patient_name",
      "fieldtype": "Data",
      "label": "Patient Name",
      "fetch_from": "patient.full_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "practitioner",
      "fieldtype": "Link",
      "label": "Practitioner",
      "options": "Practitioner",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "practitioner_name",
      "fieldtype": "Data",
      "label": "Practitioner Name",
      "fetch_from": "practitioner.full_name",
      "read_only": 1
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Medical Department",
      "in_standard_filter": 1
    },
    {
      "fieldname": "section_schedule",
      "fieldtype": "Section Break",
      "label": "Schedule"
    },
    {
      "fieldname": "appointment_date",
      "fieldtype": "Date",
      "label": "Appointment Date",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "appointment_time",
      "fieldtype": "Time",
      "label": "Appointment Time",
      "reqd": 1
    },
    {
      "fieldname": "duration",
      "fieldtype": "Int",
      "label": "Duration (minutes)",
      "default": 30
    },
    {
      "fieldname": "column_break_schedule",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Scheduled\nChecked In\nIn Progress\nCompleted\nCancelled\nNo Show",
      "default": "Scheduled",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "appointment_type",
      "fieldtype": "Select",
      "label": "Appointment Type",
      "options": "Consultation\nFollow Up\nEmergency\nRoutine Checkup",
      "default": "Consultation"
    },
    {
      "fieldname": "section_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    },
    {
      "fieldname": "reason",
      "fieldtype": "Small Text",
      "label": "Reason for Visit"
    }
  ],
  "permissions": [
    {
      "role": "Healthcare Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Physician",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "search_fields": "patient_name, practitioner_name, appointment_date",
  "title_field": "patient_name",
  "sort_field": "appointment_date",
  "sort_order": "DESC"
}
